class Solution {
    public int singleNonDuplicate(int[] nums) {
        int freq[]=new int[100001];
        int n=0;
        for(int i=0;i<nums.length;i++){
            freq[nums[i]-0]++;
        }
        for(int i=0;i<freq.length;i++){
            if(freq[i]==1){
                n=i;
            }
        }
        return n;
    }
}
