class Solution {
    public int minDeletionSize(String[] strs) {
        int n=strs.length;
        int l=strs[0].length();
        char arr[][]=new char[n][l];
         
    for (int j = 0; j < strs[0].length(); j++) 
    {
       for (int i = 0; i < strs.length; i++) 
       {
        arr[i][j] = strs[i].charAt(j);
       }
    }
    int count=0;
    for(int i=0;i<l;i++){
        List<Character>a=new ArrayList<>();
        for(int j=0;j<n;j++){
         a.add(arr[j][i]);
        }
        char max=a.get(0);
        boolean is=true;
    

for (int k = 1; k < a.size(); k++) {
    if (a.get(k - 1) > a.get(k)) {
        is = false;
        break;
    }
}
        if(is==false){
            count++;
        }
    }
    return count;
        
    }
}
