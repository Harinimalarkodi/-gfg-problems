class Solution {
    public int uniqueXorTriplets(int[] nums) {
    if(nums[0]==1&&nums[1]==1&&nums.length==2){
        return 1;
    }
       Set<Integer>ab=new HashSet<>();
       for(int i=0;i<nums.length;i++){
        for(int j=i;j<nums.length;j++){
            
                int num=nums[i]^nums[j];
              ab.add(num);
            
        }
       }
       Set<Integer>c=new HashSet<>();
       for(int i:ab){
        for(int j:nums){
            c.add(i^j);
        }
       }
       return c.size();
    }
}
